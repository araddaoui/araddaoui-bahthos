# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BYPASS_AUTH: Set to "true" ONLY in controlled local dev to skip Firebase auth.
# Omit or set to "false" in production so the real sign-in flow is enforced.
VITE_BYPASS_AUTH="false"

# STRIPE_SECRET_KEY: Required for the Stripe USD checkout flow.
# Use your Stripe test-mode key (sk_test_...) for development.
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"

# VITE_ADMIN_EMAILS: Comma-separated emails granted admin access to the
# "لوحة الإدارة" dashboard, as a complement to the Firestore profile role.
VITE_ADMIN_EMAILS="admin@example.com"

# FIREBASE_PROJECT_ID: Firebase project used to verify ID tokens on /api.
# Defaults to the production project when unset.
FIREBASE_PROJECT_ID="gen-lang-client-0535812922"

# ENFORCE_API_AUTH: "true" makes /api reject requests without a valid Firebase
# ID token. Ship the first deploy with "false" (warn-only), then flip to "true".
ENFORCE_API_AUTH="false"

# BYPASS_AUTH: "true" skips token verification entirely (local dev only).
BYPASS_AUTH="false"

# Upstash Redis: powers the deterministic response cache, per-user rate
# limiting, monthly AI quotas, the global daily circuit breaker, and the
# authoritative tier cache. When absent, all degrade to harmless no-ops (and
# monthly quotas cannot be enforced). Vercel's Upstash integration injects
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# FIREBASE_DATABASE_ID: the named Firestore database holding users/{uid}.tier,
# read by the server to resolve the authoritative tier (Option C).
FIREBASE_DATABASE_ID="ai-studio-bahthosos-387d5c26-c1cd-4070-97da-dc8503fc3a7f"

# REQUIRE_SIGNIN: "true" makes every AI route reject anonymous callers. Ship the
# client sign-in gate FIRST, verify, then flip this to "true".
REQUIRE_SIGNIN="true"

# QUOTA_FAIL_CLOSED: "true" (default) fails closed on Redis/quota-check errors
# for AI routes. Set "false" to fail open during incident response.
QUOTA_FAIL_CLOSED="true"

# GLOBAL_DAILY_AI_CAP: absolute ceiling on AI requests across ALL accounts per
# day (ultimate cost circuit breaker). 0/unset = DISABLED (safe default); set a
# positive value to opt in.
GLOBAL_DAILY_AI_CAP="1000"

# Per-group free-tier monthly request caps (Pro = these × PRO_MONTHLY_MULTIPLIER).
FREE_MONTHLY_ANALYSES="25"
FREE_MONTHLY_SYNTHESIS="25"
FREE_MONTHLY_GLOSSARY="50"
FREE_MONTHLY_CHAT="100"
FREE_MONTHLY_FOLLOWUP="25"
FREE_MONTHLY_TTS="20"
PRO_MONTHLY_MULTIPLIER="10"

# Character budgets (free per-project / free monthly / Pro monthly / Pro daily).
FREE_PROJECT_CHAR_BUDGET="60000"
FREE_MONTHLY_CHAR_BUDGET="300000"
PRO_MONTHLY_CHAR_BUDGET="1500000"
PRO_DAILY_CHAR_BUDGET="150000"
